{
  "manifest_version": 3,
  "name": "K-Sidebar",
  "version": "2.0.1",
  "icons": { "128": "icon.png" },
  "permissions": ["sidePanel", "storage", "scripting", "tabs", "windows", "downloads", "favicon", "bookmarks"],
  "host_permissions": ["<all_urls>"],
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" }
}